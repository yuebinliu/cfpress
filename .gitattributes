# ============================================================
# 行尾与文件类型统一（跨平台一致性）
# ============================================================

# 默认：仓库内一律存 LF，检出也用 LF（避免 Windows 下 CRLF 混入把整个文件标记为改动）
* text=auto eol=lf

# 明确的文本类型
*.php  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf

# 二进制资源：不做行尾/文本转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
