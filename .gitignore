# ============================================================
# CF Static Export Pro —— 忽略规则
# ============================================================

# ---- 依赖与构建缓存（不入库） ----
worker/node_modules/
worker/.wrangler/

# ---- 本机 harness / 工具链配置（含本机绝对路径与服务器凭据，不入库） ----
reasonix.toml
.reasonix/

# ---- 系统与编辑器噪声 ----
.DS_Store
Thumbs.db
*.swp
*~

# ---- 临时脚本 / 产物（本地调试用，勿入库） ----
/tmp/
*.tmp
*.log

# 主题资源快照只作部署源，不入库（体积大：kirki/图片等；需要时重新抓取或从服务器镜像）
worker/static/wp-content/themes/
