# ============================================================
# CF Static Export Pro —— 忽略规则
# ============================================================

# ---- 依赖与构建缓存（不入库） ----
worker/node_modules/
worker/.wrangler/

# ---- 本机 harness / 工具链配置（含本机绝对路径与服务器凭据，不入库） ----
reasonix.toml
.reasonix/

# ---- 系统与编辑器噪声 ----
.DS_Store
Thumbs.db
*.swp
*~

# ---- 临时脚本 / 产物（本地调试用，勿入库） ----
/tmp/
*.tmp
*.log
