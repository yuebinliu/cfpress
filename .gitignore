# ============================================================
# CF Press —— 忽略规则
# ============================================================

# ---- 依赖与构建缓存（不入库） ----
worker/node_modules/
worker/.wrangler/

# ---- Worker 本机配置（含账号级资源 ID，不入库；用 wrangler.toml.example） ----
worker/wrangler.toml

# ---- 本机 harness / 工具链配置（含本机绝对路径与服务器凭据，不入库） ----
reasonix.toml
.reasonix/

# ---- AI 工具的本地记忆目录（不入库） ----
.workbuddy/
.workbuddy-ai/

# ---- 系统与编辑器噪声 ----
.DS_Store
Thumbs.db
*.swp
*~
.wrangler/

# ---- 临时脚本 / 产物（本地调试用，勿入库） ----
/tmp/
*.tmp
*.log

# ---- 打包产物（二进制，不入库；如 cf-f637afb.zip） ----
*.zip


# backup dir used by worker/scripts/update-marked.mjs
worker/.marked-backup/

worker/dist/

# ---- 本地回滚备份（不入库）----
*.bak.css
*.bak.json
