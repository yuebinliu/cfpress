# wp-static-pro —— Worker 配置模板
#
# 用法（二选一）：
#   A) 自动：cd worker && node scripts/setup.mjs        # 创建 D1/KV/R2 并据此生成 wrangler.toml
#   B) 手工：cp wrangler.toml.example wrangler.toml，再把下面 3 个 REPLACE_* 换成你自己的 ID
#
# 资源获取命令：
#   npx wrangler d1 create <库名>          # 输出 database_id
#   npx wrangler kv namespace create <名>  # 输出 id
#   npx wrangler r2 bucket create <桶名>   # bucket_name 就是你起的名字

name = "wp-static-pro"           # Worker 名（同时决定 <name>.<account>.workers.dev）
main = "src/index.js"
compatibility_date = "2024-09-23"

# 静态资源（主题 css/js/字体/图片）随 Worker 打包；assets 命中由边缘免费直出，
# 未命中的请求（动态页 / R2 回源）才进入 Worker 逻辑。
[assets]
directory = "./static"

[vars]
ENABLE_COMPRESSION = true
# 可选：单页在 R2 未命中且 D1 也查不到时的回源地址（一般留空；配了就是「找不到就回源 WP」）
WORDPRESS_URL = ""

[[r2_buckets]]
binding = "R2_BUCKET"
bucket_name = "REPLACE_WITH_YOUR_R2_BUCKET"

[[d1_databases]]
binding = "D1_DATABASE"
database_name = "REPLACE_WITH_YOUR_D1_NAME"
database_id = "REPLACE_WITH_YOUR_D1_ID"

[[kv_namespaces]]
binding = "KV_CACHE"
id = "REPLACE_WITH_YOUR_KV_ID"

[observability]
enabled = true
head_sampling_rate = 0.1
