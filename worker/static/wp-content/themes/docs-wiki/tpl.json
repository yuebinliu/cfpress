  "comments": {
    "list": "<h3 id=\"comments-title\" class=\"comments-title\">评论（{{COMMENT_COUNT}}）</h3>\n<ol class=\"commentlist\">{{COMMENTS}}</ol>",
    "entry": "<li id=\"li-comment-{{COMMENT_ID}}\" class=\"comment {{COMMENT_ODD_EVEN}} {{COMMENT_ALT}} {{COMMENT_THREAD_CLASS}} depth-{{COMMENT_DEPTH}}\">\n  <div id=\"comment-{{COMMENT_ID}}\">\n    <div class=\"comment-author vcard\"><img src=\"{{COMMENT_AVATAR}}\" srcset=\"{{COMMENT_AVATAR_2X}} 2x\" alt=\"\" width=\"40\" height=\"40\" loading=\"lazy\"><cite class=\"fn\">{{#IF_COMMENT_AUTHOR_URL}}<a href=\"{{COMMENT_AUTHOR_URL}}\" rel=\"ugc external nofollow\">{{COMMENT_AUTHOR}}</a>{{/IF_COMMENT_AUTHOR_URL}}{{COMMENT_AUTHOR_PLAIN}}</cite></div>\n    <div class=\"comment-meta commentmetadata\"><a href=\"{{POST_URL}}#comment-{{COMMENT_ID}}\"><time datetime=\"{{COMMENT_DATETIME}}\">{{COMMENT_DATE}}</time></a></div>\n    <div class=\"comment-body\">{{COMMENT_CONTENT}}</div>\n    <div class=\"reply\"><a class=\"comment-reply-link\" data-cfse-parent=\"{{COMMENT_ID}}\" rel=\"nofollow\" href=\"#respond\">回复</a></div>\n  </div>\n  <ul class=\"children\">{{#IF_COMMENT_CHILDREN}}{{COMMENT_CHILDREN}}{{/IF_COMMENT_CHILDREN}}</ul>\n</li>",
    "children": "<li id=\"li-comment-{{COMMENT_ID}}\" class=\"comment {{COMMENT_ODD_EVEN}} depth-{{COMMENT_DEPTH}}\">\n  <div id=\"comment-{{COMMENT_ID}}\">\n    <div class=\"comment-author vcard\"><img src=\"{{COMMENT_AVATAR}}\" srcset=\"{{COMMENT_AVATAR_2X}} 2x\" alt=\"\" width=\"40\" height=\"40\" loading=\"lazy\"><cite class=\"fn\">{{#IF_COMMENT_AUTHOR_URL}}<a href=\"{{COMMENT_AUTHOR_URL}}\" rel=\"ugc external nofollow\">{{COMMENT_AUTHOR}}</a>{{/IF_COMMENT_AUTHOR_URL}}{{COMMENT_AUTHOR_PLAIN}}</cite></div>\n    <div class=\"comment-meta commentmetadata\"><a href=\"{{POST_URL}}#comment-{{COMMENT_ID}}\"><time datetime=\"{{COMMENT_DATETIME}}\">{{COMMENT_DATE}}</time></a></div>\n    <div class=\"comment-body\">{{COMMENT_CONTENT}}</div>\n    <div class=\"reply\"><a class=\"comment-reply-link\" data-cfse-parent=\"{{COMMENT_ID}}\" rel=\"nofollow\" href=\"#respond\">回复</a></div>\n  </div>\n  {{#IF_COMMENT_CHILDREN}}{{COMMENT_CHILDREN}}{{/IF_COMMENT_CHILDREN}}\n</li>",
    "form": "<div id=\"respond\" class=\"comment-respond\">\n  <h3 class=\"comment-reply-title\">发表评论</h3>\n  <form id=\"commentform\" class=\"comment-form\" action=\"/comments\" method=\"post\">\n    <p class=\"comment-notes\">邮箱不会被公开。带 <span class=\"required\">*</span> 的为必填项。</p>\n    <p><textarea id=\"comment\" name=\"comment\" rows=\"6\" required placeholder=\"写下你的想法…\"></textarea></p>\n    <p><input id=\"author\" name=\"author\" type=\"text\" required placeholder=\"昵称 *\"></p>\n    <p><input id=\"email\" name=\"email\" type=\"email\" placeholder=\"邮箱\"></p>\n    <p><input id=\"url\" name=\"url\" type=\"url\" placeholder=\"网站\"></p>\n    <p><button type=\"submit\" id=\"submit\" class=\"submit\">提交评论</button>\n    <input type=\"hidden\" name=\"comment_post_ID\" id=\"comment_post_ID\" value=\"{{COMMENT_POST_ID}}\"></p>\n  </form>\n</div>"
  }
