  "name": "文档站（docs-wiki）",
  "tpl": {
    "pageHome": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{SITE_NAME}} — {{SITE_DESC}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/docs-wiki/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"bar\">\n  <div class=\"shell bar-in\">\n    <a class=\"logo\" href=\"{{SITE_URL}}/\">{{#IF_LOGO}}{{SITE_LOGO}}{{/IF_LOGO}}<span class=\"logo-name\">{{SITE_NAME}}</span></a>\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\"><input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\"></form>\n  </div>\n  {{#IF_MENU}}<nav class=\"nav\"><div class=\"shell\">{{MENU}}</div></nav>{{/IF_MENU}}\n</header>\n<main class=\"shell page\">\n  <div class=\"hero-note\"><h1 class=\"hero-t\">{{SITE_NAME}}</h1><p class=\"hero-p\">{{SITE_DESC}}</p></div>\n  <div class=\"doc-list\">{{CONTENT}}</div>\n      <nav class=\"pager\">{{PAGINATION_PREV}}{{PAGINATION_NEXT}}</nav>\n      {{#IF_hasPage}}<p class=\"pageinfo\">第 {{PAGE_NUMBER}} 页 · 共 {{TOTAL_POSTS}} 篇</p>{{/IF_hasPage}}\n</main>\n<footer class=\"foot\">\n  <div class=\"shell foot-cards\">\n    <div class=\"fcard\"><h4>按分类浏览</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div class=\"fcard\"><h4>按时间浏览</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>",
    "pageCategory": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{TITLE}} — {{SITE_NAME}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/docs-wiki/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"bar\">\n  <div class=\"shell bar-in\">\n    <a class=\"logo\" href=\"{{SITE_URL}}/\">{{#IF_LOGO}}{{SITE_LOGO}}{{/IF_LOGO}}<span class=\"logo-name\">{{SITE_NAME}}</span></a>\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\"><input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\"></form>\n  </div>\n  {{#IF_MENU}}<nav class=\"nav\"><div class=\"shell\">{{MENU}}</div></nav>{{/IF_MENU}}\n</header>\n<main class=\"shell page\">\n  <h1 class=\"page-title\">{{TITLE}}</h1>\n  <div class=\"doc-list\">{{CONTENT}}</div>\n      <nav class=\"pager\">{{PAGINATION_PREV}}{{PAGINATION_NEXT}}</nav>\n      {{#IF_hasPage}}<p class=\"pageinfo\">第 {{PAGE_NUMBER}} 页 · 共 {{TOTAL_POSTS}} 篇</p>{{/IF_hasPage}}\n</main>\n<footer class=\"foot\">\n  <div class=\"shell foot-cards\">\n    <div class=\"fcard\"><h4>按分类浏览</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div class=\"fcard\"><h4>按时间浏览</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>",
    "pageTag": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{TITLE}} — {{SITE_NAME}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/docs-wiki/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"bar\">\n  <div class=\"shell bar-in\">\n    <a class=\"logo\" href=\"{{SITE_URL}}/\">{{#IF_LOGO}}{{SITE_LOGO}}{{/IF_LOGO}}<span class=\"logo-name\">{{SITE_NAME}}</span></a>\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\"><input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\"></form>\n  </div>\n  {{#IF_MENU}}<nav class=\"nav\"><div class=\"shell\">{{MENU}}</div></nav>{{/IF_MENU}}\n</header>\n<main class=\"shell page\">\n  <h1 class=\"page-title\">{{TITLE}}</h1>\n  <div class=\"doc-list\">{{CONTENT}}</div>\n      <nav class=\"pager\">{{PAGINATION_PREV}}{{PAGINATION_NEXT}}</nav>\n      {{#IF_hasPage}}<p class=\"pageinfo\">第 {{PAGE_NUMBER}} 页 · 共 {{TOTAL_POSTS}} 篇</p>{{/IF_hasPage}}\n</main>\n<footer class=\"foot\">\n  <div class=\"shell foot-cards\">\n    <div class=\"fcard\"><h4>按分类浏览</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div class=\"fcard\"><h4>按时间浏览</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>",
    "pageArchive": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{TITLE}} — {{SITE_NAME}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/docs-wiki/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"bar\">\n  <div class=\"shell bar-in\">\n    <a class=\"logo\" href=\"{{SITE_URL}}/\">{{#IF_LOGO}}{{SITE_LOGO}}{{/IF_LOGO}}<span class=\"logo-name\">{{SITE_NAME}}</span></a>\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\"><input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\"></form>\n  </div>\n  {{#IF_MENU}}<nav class=\"nav\"><div class=\"shell\">{{MENU}}</div></nav>{{/IF_MENU}}\n</header>\n<main class=\"shell page\">\n  <h1 class=\"page-title\">{{TITLE}}</h1>\n  <div class=\"doc-list\">{{CONTENT}}</div>\n      <nav class=\"pager\">{{PAGINATION_PREV}}{{PAGINATION_NEXT}}</nav>\n      {{#IF_hasPage}}<p class=\"pageinfo\">第 {{PAGE_NUMBER}} 页 · 共 {{TOTAL_POSTS}} 篇</p>{{/IF_hasPage}}\n</main>\n<footer class=\"foot\">\n  <div class=\"shell foot-cards\">\n    <div class=\"fcard\"><h4>按分类浏览</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div class=\"fcard\"><h4>按时间浏览</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>",
    "single": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{POST_TITLE}} — {{SITE_NAME}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/docs-wiki/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"bar\">\n  <div class=\"shell bar-in\">\n    <a class=\"logo\" href=\"{{SITE_URL}}/\">{{#IF_LOGO}}{{SITE_LOGO}}{{/IF_LOGO}}<span class=\"logo-name\">{{SITE_NAME}}</span></a>\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\"><input type=\"search\" name=\"s\" placeholder=\"搜索文档…\" aria-label=\"搜索\"></form>\n  </div>\n  {{#IF_MENU}}<nav class=\"nav\"><div class=\"shell\">{{MENU}}</div></nav>{{/IF_MENU}}\n</header>\n<main class=\"shell page\">\n  <article class=\"doc\">\n    <div class=\"doc-crumb\">{{#IF_CATEGORIES}}{{POST_CATEGORIES}}{{/IF_CATEGORIES}}</div>\n    <h1 class=\"doc-title\">{{POST_TITLE}}</h1>\n    <p class=\"doc-sub\">{{POST_EXCERPT}}</p>\n    <div class=\"doc-meta\"><time>{{POST_DATE}}</time>{{#IF_AUTHOR}}<span class=\"sep\">·</span><a href=\"{{POST_AUTHOR_URL}}\">{{POST_AUTHOR}}</a>{{/IF_AUTHOR}}</div>\n    <div class=\"content\">{{POST_CONTENT}}</div>\n    {{#IF_TAGS}}<div class=\"post-tags\">{{POST_TAGS}}</div>{{/IF_TAGS}}\n  </article>\n  <nav class=\"prevnext\">{{#IF_PREV}}<a class=\"prev\" href=\"{{PREV_URL}}\">← {{PREV_TITLE}}</a>{{/IF_PREV}}{{#IF_NEXT}}<a class=\"next\" href=\"{{NEXT_URL}}\">{{NEXT_TITLE}} →</a>{{/IF_NEXT}}</nav>\n      <section id=\"comments\" class=\"comments\">\n        <!--CFSE-COMMENTS-START id={{CFSE_POST_ID}}-->{{#IF_COMMENTS}}{{COMMENTS}}{{/IF_COMMENTS}}<!--CFSE-COMMENTS-END-->\n      </section>\n</main>\n<footer class=\"foot\">\n  <div class=\"shell foot-cards\">\n    <div class=\"fcard\"><h4>按分类浏览</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div class=\"fcard\"><h4>按时间浏览</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>",
    "item": "<article class=\"doc-item\">\n  <h2 class=\"doc-item-title\"><a href=\"{{POST_URL}}\">{{POST_TITLE}}</a></h2>\n  <p class=\"doc-item-excerpt\">{{POST_EXCERPT}}</p>\n  <div class=\"doc-item-meta\"><time>{{POST_DATE}}</time>{{#IF_CATEGORIES}}<span class=\"sep\">·</span>{{POST_CATEGORIES}}{{/IF_CATEGORIES}}<span class=\"sep\">·</span><a href=\"{{POST_URL}}#comments\">{{COMMENT_COUNT}} 条评论</a></div>\n</article>"
  },
  "sidebar": {
