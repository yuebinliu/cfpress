  "comments": {
    "list": "<h3 id=\"comments-title\" class=\"comments-title\">Comments ({{COMMENT_COUNT}})</h3>\n<ol class=\"commentlist\">{{COMMENTS}}</ol>",
    "entry": "<li id=\"li-comment-{{COMMENT_ID}}\" class=\"comment {{COMMENT_ODD_EVEN}} {{COMMENT_ALT}} {{COMMENT_THREAD_CLASS}} depth-{{COMMENT_DEPTH}}\">\n  <div id=\"comment-{{COMMENT_ID}}\" class=\"comment-inner\">\n    <div class=\"comment-author vcard\">\n      <img class=\"avatar avatar-34 photo\" src=\"{{COMMENT_AVATAR}}\" srcset=\"{{COMMENT_AVATAR_2X}} 2x\" alt=\"\" width=\"34\" height=\"34\" loading=\"lazy\">\n      <cite class=\"fn\">{{#IF_COMMENT_AUTHOR_URL}}<a href=\"{{COMMENT_AUTHOR_URL}}\" class=\"url\" rel=\"ugc external nofollow\">{{COMMENT_AUTHOR}}</a>{{/IF_COMMENT_AUTHOR_URL}}{{COMMENT_AUTHOR_PLAIN}}</cite>\n    </div>\n    <div class=\"comment-meta commentmetadata\">\n      <a href=\"{{POST_URL}}#comment-{{COMMENT_ID}}\"><time datetime=\"{{COMMENT_DATETIME}}\">{{COMMENT_DATE}}</time></a>\n    </div>\n    <div class=\"comment-body\">{{COMMENT_CONTENT}}</div>\n    <div class=\"reply\"><a class=\"comment-reply-link\" data-cfse-parent=\"{{COMMENT_ID}}\" rel=\"nofollow\" href=\"#respond\">Reply</a></div>\n  </div>\n  <ul class=\"children\">{{#IF_COMMENT_CHILDREN}}{{COMMENT_CHILDREN}}{{/IF_COMMENT_CHILDREN}}</ul>\n</li>",
    "children": "<li id=\"li-comment-{{COMMENT_ID}}\" class=\"comment {{COMMENT_ODD_EVEN}} depth-{{COMMENT_DEPTH}}\">\n  <div id=\"comment-{{COMMENT_ID}}\" class=\"comment-inner\">\n    <div class=\"comment-author vcard\">\n      <img class=\"avatar avatar-34 photo\" src=\"{{COMMENT_AVATAR}}\" srcset=\"{{COMMENT_AVATAR_2X}} 2x\" alt=\"\" width=\"34\" height=\"34\" loading=\"lazy\">\n      <cite class=\"fn\">{{#IF_COMMENT_AUTHOR_URL}}<a href=\"{{COMMENT_AUTHOR_URL}}\" class=\"url\" rel=\"ugc external nofollow\">{{COMMENT_AUTHOR}}</a>{{/IF_COMMENT_AUTHOR_URL}}{{COMMENT_AUTHOR_PLAIN}}</cite>\n    </div>\n    <div class=\"comment-meta commentmetadata\">\n      <a href=\"{{POST_URL}}#comment-{{COMMENT_ID}}\"><time datetime=\"{{COMMENT_DATETIME}}\">{{COMMENT_DATE}}</time></a>\n    </div>\n    <div class=\"comment-body\">{{COMMENT_CONTENT}}</div>\n    <div class=\"reply\"><a class=\"comment-reply-link\" data-cfse-parent=\"{{COMMENT_ID}}\" rel=\"nofollow\" href=\"#respond\">Reply</a></div>\n  </div>\n  {{#IF_COMMENT_CHILDREN}}{{COMMENT_CHILDREN}}{{/IF_COMMENT_CHILDREN}}\n</li>",
    "form": "<div id=\"respond\" class=\"comment-respond\">\n  <h3 id=\"reply-title\" class=\"comment-reply-title\">Leave a comment</h3>\n  <form id=\"commentform\" class=\"comment-form\" action=\"/comments\" method=\"post\">\n    <p class=\"comment-notes\">Your email address will not be published. Required fields are marked <span class=\"required\">*</span>.</p>\n    <p class=\"comment-form-comment\">\n      <label for=\"comment\">Comment <span class=\"required\">*</span></label>\n      <textarea id=\"comment\" name=\"comment\" rows=\"6\" maxlength=\"65525\" required></textarea>\n    </p>\n    <p class=\"comment-form-author\">\n      <label for=\"author\">Name <span class=\"required\">*</span></label>\n      <input id=\"author\" name=\"author\" type=\"text\" size=\"30\" maxlength=\"245\" autocomplete=\"name\" required>\n    </p>\n    <p class=\"comment-form-email\">\n      <label for=\"email\">Email</label>\n      <input id=\"email\" name=\"email\" type=\"email\" size=\"30\" maxlength=\"100\" autocomplete=\"email\">\n    </p>\n    <p class=\"comment-form-url\">\n      <label for=\"url\">Website</label>\n      <input id=\"url\" name=\"url\" type=\"url\" size=\"30\" maxlength=\"200\" autocomplete=\"url\">\n    </p>\n    <p class=\"form-submit\">\n      <button type=\"submit\" id=\"submit\" class=\"submit\">Post comment</button>\n      <input type=\"hidden\" name=\"comment_post_ID\" id=\"comment_post_ID\" value=\"{{COMMENT_POST_ID}}\">\n    </p>\n  </form>\n</div>"
  }
}
