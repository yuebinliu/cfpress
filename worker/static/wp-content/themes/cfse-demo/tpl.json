    "single": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{POST_TITLE}} — {{SITE_NAME}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/cfse-demo/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"topbar\">\n  <div class=\"shell topbar-in\">\n    <a class=\"brand\" href=\"{{SITE_URL}}/\"><span class=\"logo-mark\">{{BRAND_MARK}}</span><span class=\"brand-text\">{{BRAND_WORD}}</span><span class=\"badge\">beta</span></a>\n    {{#IF_MENU}}<nav class=\"nav\">{{MENU}}</nav>{{/IF_MENU}}\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\">\n      <input type=\"search\" name=\"s\" placeholder=\"Search docs…\" aria-label=\"Search\">\n    </form>\n  </div>\n</header>\n\n<main class=\"article-wrap\">\n  <div class=\"shell\">\n    <article class=\"article\">\n      <div class=\"crumbs\"><a href=\"{{SITE_URL}}/\">Home</a> <span>/</span> {{POST_CATEGORIES}}</div>\n      <h1 class=\"post-title\">{{POST_TITLE}}</h1>\n      <div class=\"post-meta\">\n        <time>{{POST_DATE}}</time>\n        {{#IF_AUTHOR}}<span class=\"sep\">·</span><a href=\"{{POST_AUTHOR_URL}}\">{{POST_AUTHOR}}</a>{{/IF_AUTHOR}}\n        <span class=\"sep\">·</span><a href=\"#comments\">Comments</a>\n      </div>\n      {{#IF_THUMBNAIL}}<figure class=\"hero\"><img src=\"{{POST_THUMBNAIL}}\" alt=\"{{POST_TITLE}}\"></figure>{{/IF_THUMBNAIL}}\n      <div class=\"content\">{{POST_CONTENT}}</div>\n      {{#IF_TAGS}}<div class=\"post-tags\">{{POST_TAGS}}</div>{{/IF_TAGS}}\n    </article>\n\n    <nav class=\"prevnext\">\n      {{#IF_PREV}}<a class=\"prev\" href=\"{{PREV_URL}}\">← {{PREV_TITLE}}</a>{{/IF_PREV}}\n      {{#IF_NEXT}}<a class=\"next\" href=\"{{NEXT_URL}}\">{{NEXT_TITLE}} →</a>{{/IF_NEXT}}\n    </nav>\n\n    <section id=\"comments\" class=\"comments\">\n      <!--CFSE-COMMENTS-START id={{CFSE_POST_ID}}-->{{#IF_COMMENTS}}{{COMMENTS}}{{/IF_COMMENTS}}<!--CFSE-COMMENTS-END-->\n    </section>\n  </div>\n</main>\n\n<footer class=\"foot\">\n  <div class=\"shell foot-grid\">\n    <div class=\"foot-brand\">\n      <span class=\"logo-mark\">{{BRAND_MARK}}</span>\n      <strong>{{SITE_NAME}}</strong>\n      <p>{{SITE_DESC}}</p>\n    </div>\n    <div><h4>Content</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div><h4>Archive</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n    <div><h4>Subscribe</h4><ul><li><a href=\"{{SITE_URL}}/feed/\">RSS feed</a></li>{{#IF_SOCIAL}}{{SOCIAL_LINKS}}{{/IF_SOCIAL}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>\n",
    "item": "<article class=\"post-card\">\n  <div class=\"card-top\">\n    {{#IF_CATEGORIES}}<span class=\"chip\">{{POST_CATEGORIES}}</span>{{/IF_CATEGORIES}}\n    <time>{{POST_DATE}}</time>\n  </div>\n  <h2><a href=\"{{POST_URL}}\">{{POST_TITLE}}</a></h2>\n  <p class=\"excerpt\">{{POST_EXCERPT}}</p>\n  <div class=\"card-foot\">\n    <a class=\"read\" href=\"{{POST_URL}}\">Read more →</a>\n    <span class=\"cc\">{{COMMENT_COUNT}} comments</span>\n  </div>\n</article>\n",
    "pageHome": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{SITE_NAME}} — {{SITE_DESC}}</title>\n<meta name=\"description\" content=\"{{SITE_DESC}}\">\n<link rel=\"stylesheet\" href=\"{{SITE_URL}}/wp-content/themes/cfse-demo/style.css\">\n<link rel=\"alternate\" type=\"application/rss+xml\" title=\"{{SITE_NAME}} &raquo; Feed\" href=\"{{SITE_URL}}/feed/\">\n</head>\n<body>\n<header class=\"topbar\">\n  <div class=\"shell topbar-in\">\n    <a class=\"brand\" href=\"{{SITE_URL}}/\"><span class=\"logo-mark\">{{BRAND_MARK}}</span><span class=\"brand-text\">{{BRAND_WORD}}</span><span class=\"badge\">beta</span></a>\n    {{#IF_MENU}}<nav class=\"nav\">{{MENU}}</nav>{{/IF_MENU}}\n    <form class=\"srch\" role=\"search\" action=\"{{SEARCH_ACTION}}\" method=\"get\">\n      <input type=\"search\" name=\"s\" placeholder=\"Search docs…\" aria-label=\"Search\">\n    </form>\n  </div>\n</header>\n\n<section class=\"hero\">\n  <div class=\"shell hero-in\">\n    <p class=\"eyebrow\">Cloudflare-native CMS · Free to start</p>\n    <h1>A real CMS<br><span class=\"grad\">on Cloudflare's free plan</span></h1>\n    <p class=\"lede\">Write in the browser, publish as static HTML to R2, and keep lists live from D1. No servers, no database bills — and if you already run WordPress, the plugin keeps both sides in sync, in both directions.</p>\n    <div class=\"cta\">\n      <a class=\"btn btn-primary\" href=\"https://deploy.workers.cloudflare.com/?url=https://github.com/yuebinliu/cfpress/tree/main/worker\">Deploy to Cloudflare →</a>\n      <a class=\"btn btn-ghost\" href=\"{{SITE_URL}}/docs/\">Read the docs</a>\n    </div>\n    <dl class=\"stats\">\n      <div><dt>$0</dt><dd>to start — runs on the free plan</dd></div>\n      <div><dt>0</dt><dd>servers to maintain</dd></div>\n      <div><dt>2-way</dt><dd>sync with WordPress</dd></div>\n      <div><dt>5</dt><dd>built-in themes, switchable online</dd></div>\n    </dl>\n  </div>\n</section>\n\n<section class=\"section\">\n  <div class=\"shell\">\n    <div class=\"sec-head\">\n      <h2>Two paths, one core</h2>\n      <p>Keep WordPress, or start from scratch. Same data layer, same rendering layer.</p>\n    </div>\n    <div class=\"routes\">\n      <a class=\"route\" href=\"{{SITE_URL}}/docs/\">\n        <span class=\"route-no\">01 / CMS</span>\n        <h3>Write here, publish to the edge</h3>\n        <p>Create posts in the built-in admin, or push from any HTTP client. Pages bake to R2; lists stay live from D1. No WordPress needed.</p>\n        <span class=\"more\">Read the docs →</span>\n      </a>\n      <a class=\"route\" href=\"{{SITE_URL}}/plugin/overview.html\">\n        <span class=\"route-no\">02 / PLUGIN</span>\n        <h3>Already on WordPress?</h3>\n        <p>Keep your editing workflow. The plugin exports posts, media and taxonomies to D1 and R2 — and pulls posts written in CF Press back into WordPress.</p>\n        <span class=\"more\">Explore the plugin →</span>\n      </a>\n    </div>\n  </div>\n</section>\n\n<section class=\"section alt\">\n  <div class=\"shell\">\n    <div class=\"sec-head\">\n      <h2>Static where it should be, live where it matters</h2>\n      <p>Purely static is rigid; purely dynamic is slow. This splits the two so each does what it does best.</p>\n    </div>\n    <div class=\"feats\">\n      <div class=\"feat\"><div class=\"ico\">S/D</div><h3>Static/Dynamic Split</h3><p>Posts are pre-rendered to HTML and stored in R2; lists, categories, tags, and archives query D1 live, so publishing updates instantly.</p></div>\n      <div class=\"feat\"><div class=\"ico\">$0</div><h3>Free Tier, For Real</h3><p>Workers, D1, R2 and KV all ship with free allowances. A normal blog or docs site fits inside them — no card, no database to provision.</p></div>\n      <div class=\"feat\"><div class=\"ico\">SK</div><h3>Online Skinning</h3><p>A style is just a directory plus a tpl.json. Switching takes effect immediately, with 5 built-in themes ready to use.</p></div>\n      <div class=\"feat\"><div class=\"ico\">OUT</div><h3>Multi-Target Publishing</h3><p>Beyond Cloudflare, publish to S3, GitHub, Netlify, Vercel, FTP, WebDAV, or a local directory.</p></div>\n      <div class=\"feat\"><div class=\"ico\">2W</div><h3>Two-Way WordPress Sync</h3><p>Export posts, media and taxonomies to Cloudflare; pull posts written in CF Press back into WordPress; comments sync in both directions.</p></div>\n      <div class=\"feat\"><div class=\"ico\">API</div><h3>Open Write API</h3><p>A subset of the WordPress REST write API plus application passwords. Obsidian plugins, scripts, and any HTTP client can publish.</p></div>\n    </div>\n  </div>\n</section>\n\n<section class=\"section\" id=\"latest\">\n  <div class=\"shell\">\n    <div class=\"sec-head\">\n      <h2>Latest Posts</h2>\n      <p>Deployment notes, feature deep-dives, and practical tips.</p>\n    </div>\n    <div class=\"post-grid\">{{CONTENT}}</div>\n    <nav class=\"pager\">{{PAGINATION_PREV}}{{PAGINATION_NEXT}}</nav>\n    {{#IF_hasPage}}<p class=\"pageinfo\">Page {{PAGE_NUMBER}} · {{TOTAL_POSTS}} posts</p>{{/IF_hasPage}}\n  </div>\n</section>\n\n<section class=\"band\">\n  <div class=\"shell band-in\">\n    <div>\n      <h2>Start on the free plan</h2>\n      <p>No card, no database to provision. Deploy the Worker, open /admin, write your first post.</p>\n    </div>\n    <a class=\"btn btn-light\" href=\"https://deploy.workers.cloudflare.com/?url=https://github.com/yuebinliu/cfpress/tree/main/worker\">Deploy now</a>\n  </div>\n</section>\n\n<footer class=\"foot\">\n  <div class=\"shell foot-grid\">\n    <div class=\"foot-brand\">\n      <span class=\"logo-mark\">{{BRAND_MARK}}</span>\n      <strong>{{SITE_NAME}}</strong>\n      <p>{{SITE_DESC}}</p>\n    </div>\n    <div><h4>Content</h4><ul>{{SIDEBAR_CATEGORIES}}</ul></div>\n    <div><h4>Archive</h4><ul>{{SIDEBAR_ARCHIVES}}</ul></div>\n    <div><h4>Subscribe</h4><ul><li><a href=\"{{SITE_URL}}/feed/\">RSS feed</a></li>{{#IF_SOCIAL}}{{SOCIAL_LINKS}}{{/IF_SOCIAL}}</ul></div>\n  </div>\n  <div class=\"shell foot-bar\">{{SITE_FOOTER}}</div>\n</footer>\n</body>\n</html>\n",
