{
  "name": "cfpress",
  "version": "2.3.0",
  "description": "CF Press — Cloudflare-native CMS: static pages in R2, live lists from D1",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node scripts/sync-themes-index.mjs && wrangler deploy",
    "bootstrap": "node scripts/setup.mjs --yes",
    "logs": "wrangler tail",
    "themes-index": "node scripts/sync-themes-index.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  },
  "dependencies": {
    "marked": "^18.0.13"
  }
}
